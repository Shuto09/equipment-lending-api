<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lending.user.UserMapper">

  <resultMap id="userRow" type="UserRow">
    <constructor>
      <idArg column="id" javaType="_long"/>
      <arg column="display_name" javaType="String"/>
      <arg column="email" javaType="String"/>
      <arg column="role" javaType="Role"/>
    </constructor>
  </resultMap>

  <select id="findById" resultMap="userRow">
    SELECT id, display_name, email, role
      FROM users
     WHERE id = #{id}
  </select>

</mapper>
