<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.lending.user.UserMapper">

  <resultMap id="userRow" type="UserRow">
    <constructor>
      <idArg column="id" javaType="_long"/>
      <arg column="display_name" javaType="String"/>
      <arg column="email" javaType="String"/>
      <arg column="role" javaType="Role"/>
    </constructor>
  </resultMap>

  <select id="findById" resultMap="userRow">
    SELECT id, display_name, email, role
      FROM users
     WHERE id = #{id}
  </select>

  <!--
    貸出の判定の前に取る行ロック。同じ人の貸出を直列化し、未返却の件数の上限（R6）を数え間違えないようにする。
    件数（集約）そのものは FOR UPDATE でロックできず、これから入る貸出の行もまだ無いので、利用者行を代表としてロックする。
  -->
  <select id="lockById" resultMap="userRow">
    SELECT id, display_name, email, role
      FROM users
     WHERE id = #{id}
       FOR UPDATE
  </select>

</mapper>
